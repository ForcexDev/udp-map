# Supabase (Project Settings → API). Sin estas variables la app corre en MODO DEMO
# (datos locales en memoria, login demo) — útil para desarrollo de UI sin backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouteService (opcional). Sin clave o ante fallo se intenta OSRM
# y, si tampoco responde, una línea recta aproximada.
VITE_ORS_API_KEY=

# ID de cliente de Google (Para Google Sign-In Nativo)
VITE_GOOGLE_CLIENT_ID=

# Web Push. La clave pública debe corresponder a VAPID_PUBLIC_KEY configurada
# como secreto de la Edge Function send-push.
VITE_VAPID_PUBLIC_KEY=
