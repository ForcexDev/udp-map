# Supabase (Project Settings → API). Sin estas variables la app corre en MODO DEMO
# (datos locales en memoria, login demo) — útil para desarrollo de UI sin backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenRouteService (https://openrouteservice.org — free tier 2.000 req/día).
# Opcional: sin key el ruteo cae a línea recta aproximada.
VITE_ORS_API_KEY=

# ID de cliente de Google (Para Google Sign-In Nativo)
VITE_GOOGLE_CLIENT_ID=
