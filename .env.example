# Plantilla de Variables de Entorno
# Copia este archivo a .env.local y llena con tus valores reales
# NUNCA subas .env.local al repositorio

# API Key de Google Gemini (para auditoría de posts con IA)
# Obtén la tuya en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# URL del proyecto Supabase
# Encuéntralo en: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima de Supabase (pública, segura para frontend)
# Encuéntrala en: https://supabase.com/dashboard → Settings → API → anon/public
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Nota: Google OAuth se configura directamente en Supabase Dashboard
# (Authentication → Providers → Google), no como variable de entorno.
