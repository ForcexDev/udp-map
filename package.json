{
  "name": "udp-map-v0.1",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Mapa colaborativo de pines + eventos + foro para la comunidad UDP",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:agents": "node scripts/gen_agents.mjs",
    "deploy:push": "npx --yes supabase functions deploy send-push",
    "supabase:login": "npx --yes supabase login",
    "check:i18n": "node scripts/check_i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
